# Copy to .env (never commit .env). There is no .env loader: export the variables in your shell, or
# point the process manager at the file (systemd EnvironmentFile=, see docs/M4.1-DEPLOYMENT-PLAN.md).
#
# ADMIN_PASSWORD is required (>= 16 characters, not a sample value) whenever HOST is not a loopback
# address or TRUST_PROXY is set. Generate one: openssl rand -base64 18
ADMIN_PASSWORD=
PORT=3001
# 127.0.0.1 behind a reverse proxy or tunnel (recommended); 0.0.0.0 only on a classroom LAN you control.
HOST=127.0.0.1
DB_PATH=data/hidden-connection.sqlite
ROUND_DURATION_MS=60000
STATIC_DIR=dist
# Behind ONE reverse proxy on the same machine (Caddy, cloudflared): loopback. Unset = off.
TRUST_PROXY=
# Projector session lifetime (60000-604800000 ms) and pairing link lifetime (30000-3600000 ms).
SCREEN_SESSION_TTL_MS=21600000
SCREEN_PAIRING_TTL_MS=300000
