{
  "name": "the-hidden-connection",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/multiplayer.mjs && node e2e/scenes.mjs && node e2e/projector.mjs && node --import tsx e2e/image-scenes.mjs",
    "e2e:images": "node --import tsx e2e/image-scenes.mjs",
    "e2e:scenes": "node e2e/scenes.mjs",
    "e2e:handoff": "node --import tsx e2e/scene-handoff.mjs",
    "e2e:projector": "node e2e/projector.mjs",
    "e2e:resilience": "node e2e/resilience.mjs",
    "e2e:restart": "node e2e/restart.mjs",
    "e2e:all": "npm run e2e && npm run e2e:handoff && npm run e2e:resilience && npm run e2e:restart && npm run e2e:presentation && npm run e2e:fullgame && npm run e2e:visual",
    "e2e:presentation": "node e2e/presentation.mjs",
    "e2e:fullgame": "node e2e/fullgame.mjs",
    "e2e:visual": "node e2e/visual.mjs",
    "trial": "node --import tsx scripts/trial/trial-server.ts",
    "e2e:deploy": "node --import tsx e2e/deploy-smoke.mjs",
    "bench": "node --import tsx e2e/bench.mjs",
    "backup": "node scripts/backup-db.mjs",
    "e2e:trial": "node --import tsx e2e/trial-isolation.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright-core": "^1.56.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
