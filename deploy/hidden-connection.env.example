# /etc/hidden-connection.env  (owner root, mode 0640, group hc) — read by systemd EnvironmentFile=.
# No quotes, no "export". Generate the password with: openssl rand -base64 18
ADMIN_PASSWORD=
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=loopback
DB_PATH=/var/lib/hidden-connection/game.sqlite
STATIC_DIR=/opt/hidden-connection/dist
ROUND_DURATION_MS=60000
SCREEN_SESSION_TTL_MS=21600000
SCREEN_PAIRING_TTL_MS=300000
NODE_ENV=production
